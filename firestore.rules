rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. GLOBAL SAFETY NET & SECURITY HELPERS
    // ==========================================

    // Default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Validates document ID string bounds and character whitelist
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Primary admin identity policy (verified email)
    function isPrimaryAdmin() {
      return isVerified() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'beingcrazyff@gmail.com';
    }

    // Secondary administrator verified via database record in /admins/{uid}
    function isRegisteredAdmin() {
      return isVerified() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Comprehensive Admin authorization check
    function isAdmin() {
      return isPrimaryAdmin() || isRegisteredAdmin();
    }

    // ==========================================
    // 2. DATA SCHEMA VALIDATORS
    // ==========================================

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'shortDescription', 'category', 'published']) &&
        data.keys().hasOnly([
          'id', 'title', 'shortDescription', 'fullDescription', 'problemStatement',
          'datasetSource', 'tools', 'methodology', 'keyFindings', 'category',
          'thumbnailUrl', 'githubUrl', 'liveUrl', 'notebookUrl', 'creationDate',
          'featured', 'published', 'updatedAt', 'createdAt'
        ]) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.shortDescription is string && data.shortDescription.size() <= 500 &&
        data.category is string && data.category.size() <= 120 &&
        data.published is bool &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('fullDescription' in data) || (data.fullDescription is string && data.fullDescription.size() <= 10000)) &&
        (!('problemStatement' in data) || (data.problemStatement is string && data.problemStatement.size() <= 5000)) &&
        (!('datasetSource' in data) || (data.datasetSource is string && data.datasetSource.size() <= 2000)) &&
        (!('methodology' in data) || (data.methodology is string && data.methodology.size() <= 5000)) &&
        (!('keyFindings' in data) || (data.keyFindings is string && data.keyFindings.size() <= 5000)) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000)) &&
        (!('githubUrl' in data) || (data.githubUrl is string && data.githubUrl.size() <= 1000)) &&
        (!('liveUrl' in data) || (data.liveUrl is string && data.liveUrl.size() <= 1000)) &&
        (!('notebookUrl' in data) || (data.notebookUrl is string && data.notebookUrl.size() <= 1000)) &&
        (!('creationDate' in data) || (data.creationDate is string && data.creationDate.size() <= 100)) &&
        (!('featured' in data) || data.featured is bool) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('tools' in data) || (data.tools is list && data.tools.size() <= 50));
    }

    function isValidSkill(data) {
      return data.keys().hasAll(['name', 'category', 'status']) &&
        data.keys().hasOnly(['id', 'name', 'category', 'status', 'description', 'icon', 'order', 'updatedAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.category is string && data.category.size() <= 120 &&
        data.status in ['Learning', 'Practicing', 'Completed'] &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('icon' in data) || (data.icon is string && data.icon.size() <= 100)) &&
        (!('order' in data) || data.order is number) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidJourney(data) {
      return data.keys().hasAll(['title', 'topic', 'status', 'date']) &&
        data.keys().hasOnly(['id', 'title', 'topic', 'description', 'date', 'status', 'relatedResources', 'githubUrl', 'order', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.topic is string && data.topic.size() <= 200 &&
        data.date is string && data.date.size() <= 100 &&
        data.status in ['Planned', 'In Progress', 'Completed'] &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        (!('relatedResources' in data) || (data.relatedResources is string && data.relatedResources.size() <= 2000)) &&
        (!('githubUrl' in data) || (data.githubUrl is string && data.githubUrl.size() <= 1000)) &&
        (!('order' in data) || data.order is number) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidCertification(data) {
      return data.keys().hasAll(['name', 'issuingOrg', 'issueDate']) &&
        data.keys().hasOnly(['id', 'name', 'issuingOrg', 'issueDate', 'credentialUrl', 'imageUrl', 'updatedAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 300 &&
        data.issuingOrg is string && data.issuingOrg.size() <= 300 &&
        data.issueDate is string && data.issueDate.size() <= 100 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('credentialUrl' in data) || (data.credentialUrl is string && data.credentialUrl.size() <= 1000)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['fullName', 'headline', 'email']) &&
        data.keys().hasOnly(['id', 'fullName', 'headline', 'shortBio', 'fullAbout', 'githubUrl', 'linkedinUrl', 'email', 'phone', 'location', 'kaggleUrl', 'resumeUrl', 'updatedAt']) &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 200 &&
        data.headline is string && data.headline.size() <= 300 &&
        data.email is string && data.email.size() <= 300 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 100)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('shortBio' in data) || (data.shortBio is string && data.shortBio.size() <= 3000)) &&
        (!('fullAbout' in data) || (data.fullAbout is string && data.fullAbout.size() <= 10000)) &&
        (!('githubUrl' in data) || (data.githubUrl is string && data.githubUrl.size() <= 1000)) &&
        (!('linkedinUrl' in data) || (data.linkedinUrl is string && data.linkedinUrl.size() <= 1000)) &&
        (!('kaggleUrl' in data) || (data.kaggleUrl is string && data.kaggleUrl.size() <= 1000)) &&
        (!('resumeUrl' in data) || (data.resumeUrl is string && data.resumeUrl.size() <= 1000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'message', 'subject', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 200)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['role']) &&
        data.keys().hasOnly(['id', 'role', 'email', 'createdAt', 'updatedAt']) &&
        data.role == 'admin' &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // ==========================================
    // 3. COLLECTION RULES
    // ==========================================

    // Projects: Public can only view published items. Admin can view drafts and perform CRUD.
    match /projects/{projectId} {
      allow get: if (resource.data.published == true) || isAdmin();
      allow list: if (resource.data.published == true) || isAdmin();
      allow create: if isValidId(projectId) && isAdmin() && isValidProject(incoming());
      allow update: if isValidId(projectId) && isAdmin() && isValidProject(incoming());
      allow delete: if isValidId(projectId) && isAdmin();
    }

    // Skills: Public can read, only admin can write
    match /skills/{skillId} {
      allow read: if true;
      allow create: if isValidId(skillId) && isAdmin() && isValidSkill(incoming());
      allow update: if isValidId(skillId) && isAdmin() && isValidSkill(incoming());
      allow delete: if isValidId(skillId) && isAdmin();
    }

    // Learning Journey: Public can read, only admin can write
    match /learning_journey/{journeyId} {
      allow read: if true;
      allow create: if isValidId(journeyId) && isAdmin() && isValidJourney(incoming());
      allow update: if isValidId(journeyId) && isAdmin() && isValidJourney(incoming());
      allow delete: if isValidId(journeyId) && isAdmin();
    }

    // Certifications: Public can read, only admin can write
    match /certifications/{certId} {
      allow read: if true;
      allow create: if isValidId(certId) && isAdmin() && isValidCertification(incoming());
      allow update: if isValidId(certId) && isAdmin() && isValidCertification(incoming());
      allow delete: if isValidId(certId) && isAdmin();
    }

    // Settings (Profile & System Metadata): Public can read, only admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isAdmin() && (settingId != 'profile' || isValidProfile(incoming()));
      allow delete: if isValidId(settingId) && isAdmin() && settingId != 'profile';
    }

    // Admins registry:
    // Only verified users can read their own admin doc; admins can read any.
    // Self-promotion is denied: only existing admins can create/update records with role='admin'.
    // Admins cannot delete their own record.
    match /admins/{userId} {
      allow read: if isAdmin() || (isVerified() && request.auth.uid == userId);
      allow create, update: if isValidId(userId) && isAdmin() && isValidAdmin(incoming());
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    // Contact Messages: Public/Anonymous can submit validated messages. Only admin can read or manage.
    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
